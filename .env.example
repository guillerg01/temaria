AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=gpt-5.6-sol
AGENTROUTER_USER_AGENT=codex_cli_rs/0.114.0

# Solo para el gateway temporal ejecutado en el PC. Si queda vacío, se reutiliza
# AGENTROUTER_API_KEY como secreto entre Render y el gateway.
TEMARIA_GATEWAY_SECRET=
TEMARIA_GATEWAY_HOST=127.0.0.1
TEMARIA_GATEWAY_PORT=4317

# Required in every environment. AUTH_SECRET must contain at least 32 characters.
SITE_PASSWORD=
AUTH_SECRET=

# Optional private JSON files. On Render, mount them as Secret Files at these paths.
# TEMARIA_CORPUS_PATH=/etc/secrets/corpus.json
# TEMARIA_ASSESSMENTS_PATH=/etc/secrets/official-assessments.json
# Required when the tracked private-data/*.enc artifacts are used.
TEMARIA_DATA_KEY=

# Optional. Defaults to the parent folder of this app during local development.
# COURSE_CONTENT_ROOT=C:\path\to\course-folders
